# Keep each parent directory traversable, then allow only server build inputs.
*
!Dockerfile
!.dockerignore
!build.gradle
!settings.gradle
!gradlew
!gradle/
gradle/*
!gradle/wrapper/
gradle/wrapper/*
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!src/
src/*
!src/main/
src/main/*
!src/main/java/
src/main/java/*
!src/main/java/pleos/
src/main/java/pleos/*
!src/main/java/pleos/nextkey/
src/main/java/pleos/nextkey/*
!src/main/java/pleos/nextkey/*.java
!src/main/java/pleos/nextkey/*/
src/main/java/pleos/nextkey/*/*
!src/main/java/pleos/nextkey/*/*.java
!src/main/resources/
src/main/resources/*
!src/main/resources/application.properties
!src/main/resources/db/
src/main/resources/db/*
!src/main/resources/db/migration/
src/main/resources/db/migration/*
!src/main/resources/db/migration/V*__*.sql
!src/main/resources/pleos/
src/main/resources/pleos/*
!src/main/resources/pleos/nextkey/
src/main/resources/pleos/nextkey/*
!src/main/resources/pleos/nextkey/lifecycle/
src/main/resources/pleos/nextkey/lifecycle/*
!src/main/resources/pleos/nextkey/lifecycle/report.properties
