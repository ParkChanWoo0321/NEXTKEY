# IntelliJ / shell environment. Replace empty fields locally.
SPRING_PROFILES_ACTIVE=dev
NEXTKEY_DB_URL=jdbc:mysql://127.0.0.1:3307/nextkey?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
NEXTKEY_DB_USER=nextkey_app
NEXTKEY_DB_PASSWORD=
NEXTKEY_MYSQL_ROOT_PASSWORD=
