# Supply the password locally only when explicitly enabling this mode. Other roles keep their own credentials.
NEXTKEY_DEV_SIMPLE_CUSTOMER_LOGIN=false
NEXTKEY_DEV_SIMPLE_CUSTOMER_PASSWORD=
NEXTKEY_PDF_FONT=C:/Windows/Fonts/malgun.ttf
